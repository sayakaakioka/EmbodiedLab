{
  "$defs": {
    "ActionSpace": {
      "additionalProperties": false,
      "description": "Robot action layout expected by the policy.",
      "properties": {
        "forward_step_meters": {
          "exclusiveMinimum": 0,
          "title": "Forward Step Meters",
          "type": "number"
        },
        "layout": {
          "items": {
            "enum": [
              "forward",
              "turn"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Layout",
          "type": "array"
        },
        "step_duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Step Duration Seconds",
          "type": "number"
        },
        "turn_degrees_per_step": {
          "exclusiveMinimum": 0,
          "title": "Turn Degrees Per Step",
          "type": "number"
        },
        "type": {
          "$ref": "#/$defs/ActionSpaceType"
        }
      },
      "required": [
        "type",
        "layout",
        "forward_step_meters",
        "turn_degrees_per_step",
        "step_duration_seconds"
      ],
      "title": "ActionSpace",
      "type": "object"
    },
    "ActionSpaceType": {
      "description": "Supported robot action space families.",
      "enum": [
        "continuous"
      ],
      "title": "ActionSpaceType",
      "type": "string"
    },
    "Bounds2D": {
      "additionalProperties": false,
      "description": "Axis-aligned world bounds on the x/z plane.",
      "properties": {
        "max": {
          "$ref": "#/$defs/Position2D"
        },
        "min": {
          "$ref": "#/$defs/Position2D"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "title": "Bounds2D",
      "type": "object"
    },
    "CollisionRewardComponent": {
      "additionalProperties": false,
      "description": "Reward component emitted on collisions.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "collision",
          "title": "Type",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "type",
        "weight"
      ],
      "title": "CollisionRewardComponent",
      "type": "object"
    },
    "Compatibility": {
      "additionalProperties": false,
      "description": "Compatibility metadata required by EmbodiedLab clients.",
      "properties": {
        "robot_version": {
          "minLength": 1,
          "title": "Robot Version",
          "type": "string"
        },
        "sensor_version": {
          "minLength": 1,
          "title": "Sensor Version",
          "type": "string"
        }
      },
      "required": [
        "robot_version",
        "sensor_version"
      ],
      "title": "Compatibility",
      "type": "object"
    },
    "CoordinateSystem": {
      "description": "Supported world coordinate systems for scenario bundles.",
      "enum": [
        "left_handed_y_up_meters"
      ],
      "title": "CoordinateSystem",
      "type": "string"
    },
    "CreatedBy": {
      "additionalProperties": false,
      "description": "Metadata about the tool that created a scenario bundle.",
      "properties": {
        "tool": {
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "version"
      ],
      "title": "CreatedBy",
      "type": "object"
    },
    "DistanceDeltaRewardComponent": {
      "additionalProperties": false,
      "description": "Reward based on distance progress toward a target object.",
      "properties": {
        "minimum_delta_meters": {
          "exclusiveMinimum": 0,
          "title": "Minimum Delta Meters",
          "type": "number"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "type": {
          "const": "distance_delta",
          "title": "Type",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "type",
        "target",
        "weight",
        "minimum_delta_meters"
      ],
      "title": "DistanceDeltaRewardComponent",
      "type": "object"
    },
    "DistanceSensor": {
      "additionalProperties": false,
      "description": "Forward distance sensor configuration.",
      "properties": {
        "direction": {
          "$ref": "#/$defs/SensorDirection"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "range_meters": {
          "exclusiveMinimum": 0,
          "title": "Range Meters",
          "type": "number"
        },
        "type": {
          "const": "distance_sensor",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "range_meters",
        "direction"
      ],
      "title": "DistanceSensor",
      "type": "object"
    },
    "ForwardCameraSensor": {
      "additionalProperties": false,
      "description": "Forward semantic camera sensor configuration.",
      "properties": {
        "far_clip_meters": {
          "exclusiveMinimum": 0,
          "title": "Far Clip Meters",
          "type": "number"
        },
        "height": {
          "maximum": 512,
          "minimum": 20,
          "title": "Height",
          "type": "integer"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mount_height_max_meters": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mount Height Max Meters"
        },
        "mount_height_meters": {
          "exclusiveMinimum": 0,
          "title": "Mount Height Meters",
          "type": "number"
        },
        "mount_height_min_meters": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mount Height Min Meters"
        },
        "near_clip_meters": {
          "exclusiveMinimum": 0,
          "title": "Near Clip Meters",
          "type": "number"
        },
        "observation_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Observation Name",
          "type": "string"
        },
        "pitch_degrees": {
          "title": "Pitch Degrees",
          "type": "number"
        },
        "semantic_mode": {
          "$ref": "#/$defs/SemanticMode"
        },
        "type": {
          "const": "forward_camera",
          "title": "Type",
          "type": "string"
        },
        "vertical_fov_degrees": {
          "exclusiveMaximum": 180,
          "exclusiveMinimum": 0,
          "title": "Vertical Fov Degrees",
          "type": "number"
        },
        "width": {
          "maximum": 512,
          "minimum": 20,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "type",
        "width",
        "height",
        "semantic_mode",
        "mount_height_meters",
        "mount_height_min_meters",
        "mount_height_max_meters",
        "pitch_degrees",
        "vertical_fov_degrees",
        "near_clip_meters",
        "far_clip_meters",
        "observation_name"
      ],
      "title": "ForwardCameraSensor",
      "type": "object"
    },
    "GoalSpec": {
      "additionalProperties": false,
      "description": "Goal region used for navigation training.",
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position2D"
        },
        "radius": {
          "exclusiveMinimum": 0,
          "title": "Radius",
          "type": "number"
        }
      },
      "required": [
        "id",
        "position",
        "radius"
      ],
      "title": "GoalSpec",
      "type": "object"
    },
    "GoalVectorSensor": {
      "additionalProperties": false,
      "description": "Goal-relative numeric observation consumed by the policy.",
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "observation_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Observation Name",
          "type": "string"
        },
        "target": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "type": {
          "const": "goal_vector",
          "title": "Type",
          "type": "string"
        },
        "values": {
          "items": {
            "enum": [
              "goal_angle_degrees",
              "goal_distance_meters"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "target",
        "observation_name",
        "values"
      ],
      "title": "GoalVectorSensor",
      "type": "object"
    },
    "MaximumAbsoluteForwardRewardComponent": {
      "additionalProperties": false,
      "description": "Penalty enabled when forward action stays below a threshold.",
      "properties": {
        "maximum_absolute_forward": {
          "maximum": 1,
          "minimum": 0,
          "title": "Maximum Absolute Forward",
          "type": "number"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "maximum_absolute_forward",
          "title": "Type",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "type",
        "weight",
        "maximum_absolute_forward"
      ],
      "title": "MaximumAbsoluteForwardRewardComponent",
      "type": "object"
    },
    "MinimumAbsoluteAngleRewardComponent": {
      "additionalProperties": false,
      "description": "Penalty enabled above an absolute goal-angle threshold.",
      "properties": {
        "minimum_absolute_angle_degrees": {
          "exclusiveMinimum": 0,
          "maximum": 180,
          "title": "Minimum Absolute Angle Degrees",
          "type": "number"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "minimum_absolute_angle",
          "title": "Type",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "type",
        "weight",
        "minimum_absolute_angle_degrees"
      ],
      "title": "MinimumAbsoluteAngleRewardComponent",
      "type": "object"
    },
    "PerStepRewardComponent": {
      "additionalProperties": false,
      "description": "Reward component emitted at each simulation step.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "per_step",
          "title": "Type",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "type",
        "weight"
      ],
      "title": "PerStepRewardComponent",
      "type": "object"
    },
    "Pose2D": {
      "additionalProperties": false,
      "description": "Robot pose on the x/z plane.",
      "properties": {
        "position": {
          "$ref": "#/$defs/Position2D"
        },
        "rotation_y_degrees": {
          "title": "Rotation Y Degrees",
          "type": "number"
        }
      },
      "required": [
        "position",
        "rotation_y_degrees"
      ],
      "title": "Pose2D",
      "type": "object"
    },
    "Position2D": {
      "additionalProperties": false,
      "description": "A point on the horizontal x/z plane.",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "z"
      ],
      "title": "Position2D",
      "type": "object"
    },
    "RewardSpec": {
      "additionalProperties": false,
      "description": "Declarative reward configuration for training.",
      "properties": {
        "components": {
          "items": {
            "discriminator": {
              "mapping": {
                "collision": "#/$defs/CollisionRewardComponent",
                "distance_delta": "#/$defs/DistanceDeltaRewardComponent",
                "maximum_absolute_forward": "#/$defs/MaximumAbsoluteForwardRewardComponent",
                "minimum_absolute_angle": "#/$defs/MinimumAbsoluteAngleRewardComponent",
                "per_step": "#/$defs/PerStepRewardComponent",
                "terminal_reward": "#/$defs/TerminalRewardComponent"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TerminalRewardComponent"
              },
              {
                "$ref": "#/$defs/DistanceDeltaRewardComponent"
              },
              {
                "$ref": "#/$defs/CollisionRewardComponent"
              },
              {
                "$ref": "#/$defs/PerStepRewardComponent"
              },
              {
                "$ref": "#/$defs/MinimumAbsoluteAngleRewardComponent"
              },
              {
                "$ref": "#/$defs/MaximumAbsoluteForwardRewardComponent"
              }
            ]
          },
          "maxItems": 7,
          "minItems": 7,
          "title": "Components",
          "type": "array"
        }
      },
      "required": [
        "components"
      ],
      "title": "RewardSpec",
      "type": "object"
    },
    "RobotSpec": {
      "additionalProperties": false,
      "description": "Robot descriptor for a scenario bundle.",
      "properties": {
        "action_space": {
          "$ref": "#/$defs/ActionSpace"
        },
        "radius": {
          "exclusiveMinimum": 0,
          "title": "Radius",
          "type": "number"
        },
        "start_pose": {
          "$ref": "#/$defs/Pose2D"
        },
        "type": {
          "$ref": "#/$defs/RobotType"
        }
      },
      "required": [
        "type",
        "radius",
        "start_pose",
        "action_space"
      ],
      "title": "RobotSpec",
      "type": "object"
    },
    "RobotType": {
      "description": "Robot archetypes supported by the current scenario contract.",
      "enum": [
        "simple_robot"
      ],
      "title": "RobotType",
      "type": "string"
    },
    "SemanticMode": {
      "description": "Supported semantic camera encodings.",
      "enum": [
        "traversable_vs_blocked"
      ],
      "title": "SemanticMode",
      "type": "string"
    },
    "SensorDirection": {
      "description": "Supported distance sensor directions.",
      "enum": [
        "forward"
      ],
      "title": "SensorDirection",
      "type": "string"
    },
    "Size2D": {
      "additionalProperties": false,
      "description": "A positive x/z footprint size in meters.",
      "properties": {
        "x": {
          "exclusiveMinimum": 0,
          "title": "X",
          "type": "number"
        },
        "z": {
          "exclusiveMinimum": 0,
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "z"
      ],
      "title": "Size2D",
      "type": "object"
    },
    "StaticObstacle": {
      "additionalProperties": false,
      "description": "A fixed obstacle in the scenario.",
      "properties": {
        "center": {
          "$ref": "#/$defs/Position2D"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "rotation_y_degrees": {
          "title": "Rotation Y Degrees",
          "type": "number"
        },
        "shape": {
          "const": "box",
          "title": "Shape",
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/Size2D"
        }
      },
      "required": [
        "id",
        "shape",
        "center",
        "size",
        "height",
        "rotation_y_degrees"
      ],
      "title": "StaticObstacle",
      "type": "object"
    },
    "StaticWall": {
      "additionalProperties": false,
      "description": "A fixed wall segment in the scenario.",
      "properties": {
        "center": {
          "$ref": "#/$defs/Position2D"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "rotation_y_degrees": {
          "title": "Rotation Y Degrees",
          "type": "number"
        },
        "size": {
          "$ref": "#/$defs/Size2D"
        }
      },
      "required": [
        "id",
        "center",
        "size",
        "height",
        "rotation_y_degrees"
      ],
      "title": "StaticWall",
      "type": "object"
    },
    "TerminalRewardComponent": {
      "additionalProperties": false,
      "description": "Terminal reward paid when the task succeeds.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "terminal_reward",
          "title": "Type",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "type",
        "weight"
      ],
      "title": "TerminalRewardComponent",
      "type": "object"
    },
    "TrainingAlgorithm": {
      "description": "Supported training algorithms for scenario bundles.",
      "enum": [
        "ppo"
      ],
      "title": "TrainingAlgorithm",
      "type": "string"
    },
    "TrainingDevice": {
      "description": "Training devices supported by the current Cloud Run runtime.",
      "enum": [
        "cpu"
      ],
      "title": "TrainingDevice",
      "type": "string"
    },
    "TrainingSpec": {
      "additionalProperties": false,
      "description": "Training request parameters for scenario bundles.",
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/TrainingAlgorithm"
        },
        "batch_size": {
          "maximum": 65536,
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "clip_range": {
          "exclusiveMinimum": 0.0,
          "title": "Clip Range",
          "type": "number"
        },
        "clip_range_vf": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Clip Range Vf"
        },
        "cpu_count": {
          "anyOf": [
            {
              "maximum": 32,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cpu Count"
        },
        "device": {
          "$ref": "#/$defs/TrainingDevice"
        },
        "ent_coef": {
          "minimum": 0.0,
          "title": "Ent Coef",
          "type": "number"
        },
        "eval_episodes": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Eval Episodes",
          "type": "integer"
        },
        "gae_lambda": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Gae Lambda",
          "type": "number"
        },
        "gamma": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Gamma",
          "type": "number"
        },
        "learning_rate": {
          "exclusiveMinimum": 0.0,
          "title": "Learning Rate",
          "type": "number"
        },
        "max_episode_steps": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Episode Steps",
          "type": "integer"
        },
        "max_grad_norm": {
          "minimum": 0.0,
          "title": "Max Grad Norm",
          "type": "number"
        },
        "n_envs": {
          "maximum": 32,
          "minimum": 1,
          "title": "N Envs",
          "type": "integer"
        },
        "n_epochs": {
          "maximum": 100,
          "minimum": 1,
          "title": "N Epochs",
          "type": "integer"
        },
        "n_steps": {
          "maximum": 65536,
          "minimum": 1,
          "title": "N Steps",
          "type": "integer"
        },
        "normalize_advantage": {
          "title": "Normalize Advantage",
          "type": "boolean"
        },
        "randomize_start": {
          "title": "Randomize Start",
          "type": "boolean"
        },
        "replay_eval_interval_steps": {
          "minimum": 0,
          "title": "Replay Eval Interval Steps",
          "type": "integer"
        },
        "replay_train_chunk_steps": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Replay Train Chunk Steps",
          "type": "integer"
        },
        "sde_sample_freq": {
          "minimum": -1,
          "title": "Sde Sample Freq",
          "type": "integer"
        },
        "seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "stats_window_size": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Stats Window Size",
          "type": "integer"
        },
        "target_kl": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Kl"
        },
        "timesteps": {
          "maximum": 10000000,
          "minimum": 1,
          "title": "Timesteps",
          "type": "integer"
        },
        "torch_num_threads": {
          "anyOf": [
            {
              "maximum": 32,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Torch Num Threads"
        },
        "use_sde": {
          "title": "Use Sde",
          "type": "boolean"
        },
        "vf_coef": {
          "minimum": 0.0,
          "title": "Vf Coef",
          "type": "number"
        }
      },
      "required": [
        "algorithm",
        "device",
        "timesteps",
        "seed",
        "max_episode_steps",
        "n_envs",
        "cpu_count",
        "torch_num_threads",
        "n_steps",
        "batch_size",
        "n_epochs",
        "gamma",
        "gae_lambda",
        "learning_rate",
        "clip_range",
        "clip_range_vf",
        "normalize_advantage",
        "ent_coef",
        "vf_coef",
        "max_grad_norm",
        "use_sde",
        "sde_sample_freq",
        "target_kl",
        "stats_window_size",
        "eval_episodes",
        "replay_eval_interval_steps",
        "replay_train_chunk_steps",
        "randomize_start"
      ],
      "title": "TrainingSpec",
      "type": "object"
    },
