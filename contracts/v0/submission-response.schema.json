{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response returned after accepting a new submission.",
  "properties": {
    "cancel_token": {
      "maxLength": 128,
      "minLength": 32,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Cancel Token",
      "type": "string"
    },
    "status": {
      "const": "accepted",
      "title": "Status",
      "type": "string"
    },
    "submission_id": {
      "minLength": 1,
      "title": "Submission Id",
      "type": "string"
    }
  },
  "required": [
    "status",
    "submission_id",
    "cancel_token"
  ],
  "title": "SubmissionResponse",
  "type": "object"
}
