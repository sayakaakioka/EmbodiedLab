{
  "$defs": {
    "EvalReplayBundleChunk": {
      "additionalProperties": false,
      "description": "One deterministic evaluation Replay chunk.",
      "properties": {
        "avg_reward": {
          "title": "Avg Reward",
          "type": "number"
        },
        "avg_steps": {
          "minimum": 0.0,
          "title": "Avg Steps",
          "type": "number"
        },
        "checkpoint_step": {
          "minimum": 0,
          "title": "Checkpoint Step",
          "type": "integer"
        },
        "end_step": {
          "title": "End Step",
          "type": "null"
        },
        "episode_count": {
          "minimum": 0,
          "title": "Episode Count",
          "type": "integer"
        },
        "format": {
          "const": "jsonl.gz",
          "title": "Format",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^eval/[A-Za-z0-9._-]+\\.jsonl\\.gz$",
          "title": "Path",
          "type": "string"
        },
        "phase": {
          "const": "eval",
          "title": "Phase",
          "type": "string"
        },
        "policy_mode": {
          "const": "deterministic",
          "title": "Policy Mode",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "start_step": {
          "title": "Start Step",
          "type": "null"
        },
        "step_count": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Step Count",
          "type": "integer"
        },
        "success_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Success Rate",
          "type": "number"
        }
      },
      "required": [
        "checkpoint_step",
        "path",
        "format",
        "size_bytes",
        "sha256",
        "phase",
        "policy_mode",
        "start_step",
        "end_step",
        "step_count",
        "episode_count",
        "success_rate",
        "avg_reward",
        "avg_steps"
      ],
      "title": "EvalReplayBundleChunk",
      "type": "object"
    },
    "TrainReplayBundleChunk": {
      "additionalProperties": false,
      "description": "One stochastic training Replay chunk.",
      "properties": {
        "avg_reward": {
          "title": "Avg Reward",
          "type": "null"
        },
        "avg_steps": {
          "title": "Avg Steps",
          "type": "null"
        },
        "checkpoint_step": {
          "minimum": 0,
          "title": "Checkpoint Step",
          "type": "integer"
        },
        "end_step": {
          "minimum": 0,
          "title": "End Step",
          "type": "integer"
        },
        "episode_count": {
          "title": "Episode Count",
          "type": "null"
        },
        "format": {
          "const": "jsonl.gz",
          "title": "Format",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^train/[A-Za-z0-9._-]+\\.jsonl\\.gz$",
          "title": "Path",
          "type": "string"
        },
        "phase": {
          "const": "train",
          "title": "Phase",
          "type": "string"
        },
        "policy_mode": {
          "const": "stochastic",
          "title": "Policy Mode",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "start_step": {
          "minimum": 0,
          "title": "Start Step",
          "type": "integer"
        },
        "step_count": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Step Count",
          "type": "integer"
        },
        "success_rate": {
          "title": "Success Rate",
          "type": "null"
        }
      },
      "required": [
        "checkpoint_step",
        "path",
        "format",
        "size_bytes",
        "sha256",
        "phase",
        "policy_mode",
        "start_step",
        "end_step",
        "step_count",
        "episode_count",
        "success_rate",
        "avg_reward",
        "avg_steps"
      ],
      "title": "TrainReplayBundleChunk",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Manifest describing the chunks in one Replay Bundle.",
  "properties": {
    "chunks": {
      "items": {
        "discriminator": {
          "mapping": {
            "eval": "#/$defs/EvalReplayBundleChunk",
            "train": "#/$defs/TrainReplayBundleChunk"
          },
          "propertyName": "phase"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TrainReplayBundleChunk"
          },
          {
            "$ref": "#/$defs/EvalReplayBundleChunk"
          }
        ]
      },
      "maxItems": 4096,
      "minItems": 1,
      "title": "Chunks",
      "type": "array"
    },
    "job_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "replay-bundle.v0",
      "title": "Schema Version",
      "type": "string"
    },
    "total_timesteps": {
      "maximum": 10000000,
      "minimum": 1,
      "title": "Total Timesteps",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "scenario_id",
    "total_timesteps",
    "chunks"
  ],
  "title": "ReplayBundleManifest",
  "type": "object"
}
